# policywright — local environment (copy to .env; .env is gitignored)
#
# Only scripts/deploy-testnet.sh reads these. The demo, tests, CLI synth/
# simulate, and CI need NO environment variables and no secrets at all.
#
# TESTNET KEYS ONLY. Never put a mainnet secret here.
#
# Do NOT add STELLAR_RPC_URL: stellar-cli dotenv-loads ./.env from the cwd,
# and a bare rpc-url there breaks every `--network` invocation from the repo
# root (docs/FACTS.md §1.6).

STELLAR_SECRET_KEY=SC...your-testnet-secret-key...
STELLAR_PUBLIC_KEY=G...the-matching-public-key...
STELLAR_NETWORK=testnet
