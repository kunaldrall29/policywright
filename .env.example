# policywright — local environment (copy to .env; .env is gitignored)
#
# scripts/deploy-testnet.sh reads signing keys. The demo, tests, CLI synth/
# simulate, and CI need NO secrets. The MCP server never signs.
#
# TESTNET KEYS ONLY. Never put a mainnet secret here.
#
# Do NOT put STELLAR_RPC_URL in .env for stellar-cli: it dotenv-loads ./.env
# from the cwd, and a bare rpc-url there breaks every `--network` invocation
# from the repo root (docs/FACTS.md §1.6). Pass --rpc-url / MCP rpcUrl instead,
# or export STELLAR_RPC_URL only in the MCP process environment.

STELLAR_SECRET_KEY=SC...your-testnet-secret-key...
STELLAR_PUBLIC_KEY=G...the-matching-public-key...
STELLAR_NETWORK=testnet
# Optional (MCP / CLI record only — prefer flags over .env for stellar-cli):
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
